<Window x:Class="RustOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rust Optimizer" Width="600" Height="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Палитра (Глубокий тёмно-красный стиль) -->
        <SolidColorBrush x:Key="BgDark" Color="#0A0405"/>
        <SolidColorBrush x:Key="BgCard" Color="#14080A"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#1F0C0F"/>
        <SolidColorBrush x:Key="AccentRed" Color="#D91E2A"/>
        <SolidColorBrush x:Key="AccentRedBright" Color="#FF2A38"/>
        <SolidColorBrush x:Key="BorderRed" Color="#331115"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8F6E72"/>

        <!-- Главная красная кнопка -->
        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="10" BorderThickness="1" BorderBrush="#FF5C67">
                            <Border.Effect>
                                <DropShadowEffect Color="#D91E2A" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentRedBright}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#240E11"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#361519"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="#5E4346"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Второстепенная кнопка (Выбрать папку / Назад / Язык) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C0A0D"/>
            <Setter Property="BorderBrush" Value="#3D151A"/>
            <Setter Property="Foreground" Value="#C4A3A7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" 
                                CornerRadius="7" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#290F13"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопки Buy Me a Coffee / Donate -->
        <Style x:Key="DonateButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F0A0D"/>
            <Setter Property="BorderBrush" Value="#59161D"/>
            <Setter Property="Foreground" Value="#FFD6D9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.2" 
                                CornerRadius="8" Padding="16,6">
                            <Border.Effect>
                                <DropShadowEffect Color="#D91E2A" BlurRadius="12" ShadowDepth="0" Opacity="0.2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource AccentRed}"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#FF6B75"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки управления окном (Свернуть / Закрыть) -->
        <Style x:Key="WinControlBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#17090B"/>
            <Setter Property="BorderBrush" Value="#331115"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource AccentRed}"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource AccentRedBright}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточки выбора FPS (+30, +60, +120, +240) -->
        <Style x:Key="FpsRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderRed}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" 
                                CornerRadius="10" Margin="6" Padding="14,12">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="22" FontWeight="Bold" 
                                           HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                           FontSize="11" Foreground="{StaticResource TextMuted}" 
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgCardHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#290A0E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentRedBright}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentRedBright}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Главный корпус 600x900 -->
    <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderRed}" 
            BorderThickness="1.5" CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="95"/>
            </Grid.RowDefinitions>

            <!-- Фоновое мягкое красное свечение сверху -->
            <Ellipse Width="520" Height="180" Fill="#42080E" VerticalAlignment="Top" Margin="0,-100,0,0" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="95"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- ================= ВЕРХНЯЯ ПАНЕЛЬ ================= -->
            <Grid Grid.Row="0" Margin="28,0,22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="#24090D" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                        <Path Data="M11,2 L4,11 L10,11 L9,18 L16,9 L10,9 Z" Fill="{StaticResource AccentRedBright}" Stretch="Uniform" Width="15" Height="15"/>
                    </Border>
                    <TextBlock Text="RUST" FontSize="21" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="OPTIMIZER" FontSize="21" FontWeight="Light" Foreground="{StaticResource AccentRedBright}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Флаги RU / ENG + Кнопки окна -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnLangRu" Style="{StaticResource SecondaryButtonStyle}" Click="BtnLangRu_Click" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas Width="18" Height="12" Margin="0,0,6,0" ClipToBounds="True">
                                <Rectangle Width="18" Height="4" Fill="White" Canvas.Top="0"/>
                                <Rectangle Width="18" Height="4" Fill="#0039A6" Canvas.Top="4"/>
                                <Rectangle Width="18" Height="4" Fill="#D52B1E" Canvas.Top="8"/>
                            </Canvas>
                            <TextBlock Text="RU" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnLangEn" Style="{StaticResource SecondaryButtonStyle}" Click="BtnLangEn_Click" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas Width="18" Height="12" Margin="0,0,6,0" ClipToBounds="True" Background="#012169">
                                <Path Stroke="White" StrokeThickness="2" Data="M0,0 L18,12 M18,0 L0,12"/>
                                <Path Stroke="White" StrokeThickness="4" Data="M9,0 L9,12 M0,6 L18,6"/>
                                <Path Stroke="#C8102E" StrokeThickness="2" Data="M9,0 L9,12 M0,6 L18,6"/>
                            </Canvas>
                            <TextBlock Text="ENG" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource WinControlBtn}" Click="Minimize_Click" Margin="0,0,6,0" ToolTip="Minimize">
                        <Path Data="M0,0 L10,0" Stroke="White" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource WinControlBtn}" Click="Close_Click" ToolTip="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="White" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= ЦЕНТРАЛЬНАЯ ЧАСТЬ ================= -->
            <Grid Grid.Row="1" Margin="35,5,35,5">

                <!-- ЭКРАН 1: ЗАГРУЗКА 0% -> 100% (3 СЕКУНДЫ) И ПОИСК RUST -->
                <Grid x:Name="ScreenSearch" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center">

                        <!-- Векторная иконка по центру -->
                        <Grid Width="116" Height="116" HorizontalAlignment="Center" Margin="0,0,0,28">
                            <Ellipse Fill="#1A0709" Stroke="#3D1217" StrokeThickness="1.5"/>
                            <Ellipse Width="96" Height="96" Fill="#24090D" Stroke="{StaticResource AccentRed}" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#D91E2A" BlurRadius="28" ShadowDepth="0" Opacity="0.5"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <Path x:Name="CenterVectorIcon" 
                                  Data="M26,4 L8,26 L22,26 L18,44 L38,20 L24,20 Z" 
                                  Fill="{StaticResource AccentRedBright}" Stretch="Uniform" Width="42" Height="42"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="TxtStep1Title" Text="СКАНИРОВАНИЕ СИСТЕМЫ" FontSize="23" FontWeight="Bold" 
                                   Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtStep1Subtitle" Text="Поиск установленной игры Rust и анализ ПК..." FontSize="13.5" 
                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,28" TextAlignment="Center"/>

                        <!-- Блок загрузки 0% - 100% за 3 секунды -->
                        <StackPanel x:Name="LoadingPanel" Width="420" HorizontalAlignment="Center" Margin="0,0,0,25">
                            <TextBlock x:Name="TxtPercent" Text="0%" FontSize="28" FontWeight="Black" 
                                       Foreground="{StaticResource AccentRedBright}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                            <Border Height="10" Background="#1A080A" BorderBrush="#331115" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                                <Grid HorizontalAlignment="Left" Width="420">
                                    <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="4">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#9E111B" Offset="0"/>
                                                <GradientStop Color="#FF2A38" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Карточка с найденным путем (появляется после 100%) -->
                        <Border x:Name="FoundPathCard" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderRed}" 
                                BorderThickness="1.5" CornerRadius="12" Padding="20,18" Margin="0,0,0,28" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="TxtFoundLabel" Text="ПАПКА ИГРЫ RUST:" FontSize="11" FontWeight="Bold" 
                                               Foreground="{StaticResource AccentRedBright}" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TxtRustPath" Text="C:\Program Files (x86)\Steam\steamapps\common\Rust" 
                                               FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button x:Name="BtnBrowseManual" Grid.Column="1" Content="Изменить..." VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowseManual_Click" FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Кнопка Продолжить -->
                        <Button x:Name="BtnContinueToOpt" Content="ПРОДОЛЖИТЬ" Height="54" Width="300"
                                Style="{StaticResource MainButtonStyle}" Visibility="Collapsed" Click="BtnContinueToOpt_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ЭКРАН 2: ПАРАМЕТРЫ ОПТИМИЗАЦИИ И ВЫБОР FPS -->
                <Grid x:Name="ScreenOptimize" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top">

                        <Grid Margin="0,0,0,12">
                            <Button x:Name="BtnBack" Content="← Назад" HorizontalAlignment="Left" 
                                    Style="{StaticResource SecondaryButtonStyle}" Click="BtnBack_Click" FontSize="12"/>
                            <TextBlock x:Name="TxtHwTitle" Text="ХАРАКТЕРИСТИКИ ВАШЕГО ПК" FontSize="13" FontWeight="Bold" 
                                       Foreground="{StaticResource AccentRedBright}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Карточка железа -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderRed}" 
                                BorderThickness="1.5" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="CPU" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtCpuName" Text="Detecting..." Foreground="White" FontSize="12.5" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="GPU" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtGpuName" Text="Detecting..." Foreground="White" FontSize="12.5" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="RAM" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtRamSize" Text="Detecting..." Foreground="White" FontSize="12.5" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Background="#1F0B0E" CornerRadius="6" Padding="10,5">
                                    <TextBlock x:Name="TxtRecommendedProfile" Text="Подобранный профиль: High-End PvP" 
                                               Foreground="#FF4D58" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Реальные лимиты FPS, а не обещания прироста -->
                        <TextBlock x:Name="TxtFpsTitle" Text="ВЫБЕРИТЕ ЛИМИТ FPS" FontSize="14" FontWeight="Bold" 
                                   Foreground="White" Margin="0,0,0,3"/>
                        <TextBlock x:Name="TxtFpsDesc" Text="Это верхний лимит кадров, а не обещание прироста FPS. Результат зависит от ПК и сервера." 
                                   FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>

                        <UniformGrid Rows="2" Columns="2" Margin="-6,0,-6,14">
                            <RadioButton x:Name="RbFps30" Content="60 FPS" Tag="Тихое меню и умеренная нагрузка" Style="{StaticResource FpsRadioStyle}"/>
                            <RadioButton x:Name="RbFps60" Content="120 FPS" Tag="Сбалансированный режим" Style="{StaticResource FpsRadioStyle}"/>
                            <RadioButton x:Name="RbFps120" Content="144 FPS" Tag="Для монитора 144 Гц" Style="{StaticResource FpsRadioStyle}"/>
                            <RadioButton x:Name="RbFps240" Content="240 FPS" Tag="Потолок FPS, не гарантия" Style="{StaticResource FpsRadioStyle}" IsChecked="True"/>
                        </UniformGrid>

                        <!-- Настройки, которые программа действительно записывает в client.cfg -->
                        <Border x:Name="FixedSettingsPanel" Background="{StaticResource BgCard}" BorderBrush="{StaticResource AccentRed}"
                                BorderThickness="1.5" CornerRadius="12" Padding="16,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="TxtFixedSettingsTitle" Text="ФИКСИРОВАННЫЕ НАСТРОЙКИ" FontSize="13"
                                           FontWeight="Bold" Foreground="White" Margin="0,0,0,3"/>
                                <TextBlock x:Name="TxtFixedSettingsSub" Text="Музыка: 0%  ·  FOV: 90  ·  VSync: OFF  ·  FPS в меню: 60"
                                           FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Лог установки -->
                        <Border Background="#070203" BorderBrush="{StaticResource BorderRed}" BorderThickness="1" 
                                CornerRadius="10" Padding="12,8" Height="88" Margin="0,0,0,14">
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Hidden">
                                <TextBlock x:Name="TxtConsoleLog" Text="> Готов к установке параметров оптимизации..." 
                                           FontFamily="Consolas" FontSize="12" Foreground="#C49B9E" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Кнопка Применить -->
                        <Button x:Name="BtnApplyOptimization" Content="ПРИМЕНИТЬ ОПТИМИЗАЦИЮ" Height="48"
                                Style="{StaticResource MainButtonStyle}" Click="BtnApplyOptimization_Click"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnVerifySettings" Grid.Column="0" Content="ПРОВЕРИТЬ КОНФИГ" Height="34"
                                    Margin="0,0,4,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnVerifySettings_Click"/>
                            <Button x:Name="BtnRestoreBackup" Grid.Column="1" Content="ВОССТАНОВИТЬ КОНФИГ" Height="34"
                                    Margin="4,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnRestoreBackup_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>

            </Grid>

            <!-- ================= НИЖНИЙ БЛОК АВТОРА + BUY ME A COFFEE ================= -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Made By Melsaqada" FontSize="12.5" FontWeight="Bold" 
                           Foreground="#D9B8BB" HorizontalAlignment="Center" Margin="0,0,0,2"/>

                <TextBlock HorizontalAlignment="Center" FontSize="11.5" Margin="0,0,0,8">
                    <Hyperlink NavigateUri="https://www.youtube.com/@Melsaqada" 
                               RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource AccentRedBright}" TextDecorations="None">
                        https://www.youtube.com/@Melsaqada
                    </Hyperlink>
                </TextBlock>

                <!-- Кнопка со встроенной ссылкой на DonationAlerts -->
                <Button x:Name="BtnDonate" Style="{StaticResource DonateButtonStyle}" 
                        Click="BtnDonate_Click" HorizontalAlignment="Center"
                        ToolTip="https://www.donationalerts.com/r/melsaqadayt">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Векторная иконка чашки кофе -->
                        <Path Data="M2,5 L12,5 L12,10 C12,12.2 10.2,14 8,14 L6,14 C3.8,14 2,12.2 2,10 Z M12,6 L14,6 C15.1,6 16,6.9 16,8 C16,9.1 15.1,10 14,10 L12,10 M1,16 L13,16" 
                              Stroke="#FF4D58" StrokeThickness="1.6" Fill="Transparent" 
                              Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDonateBtn" Text="Buy Me a Coffee ☕" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>